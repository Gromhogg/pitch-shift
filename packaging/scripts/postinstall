#!/bin/bash
# Runs as admin after Pitch Shift is copied to /Applications: installs Pitch Shift Mic, puts a shortcut on the
# Desktop of whoever is logged in, and opens the app.
app="/Applications/Pitch Shift.app"
"$app/Contents/Resources/install-driver.sh" || echo "Pitch Shift Mic could not be installed"
xattr -dr com.apple.quarantine "$app" 2>/dev/null

user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != "root" ] && [ "$user" != "loginwindow" ]; then
  uid=$(id -u "$user")
  home=$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')
  # A shortcut on the Desktop. macOS privacy rules may block this from an installer; install.sh also makes it.
  desktop="$home/Desktop/Pitch Shift.app"
  if [ ! -e "$desktop" ] || [ -L "$desktop" ]; then
    launchctl asuser "$uid" sudo -u "$user" ln -sfn "$app" "$desktop" 2>/dev/null
  fi
  if [ -z "${COMMAND_LINE_INSTALL:-}" ]; then launchctl asuser "$uid" sudo -u "$user" open "$app"; fi
fi
exit 0
