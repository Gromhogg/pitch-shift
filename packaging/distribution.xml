<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Pitch Shift</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="14.4"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"><line choice="local.pitch-shift.pkg"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="local.pitch-shift.pkg" visible="false"><pkg-ref id="local.pitch-shift.pkg"/></choice>
    <pkg-ref id="local.pitch-shift.pkg" version="VERSION" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
