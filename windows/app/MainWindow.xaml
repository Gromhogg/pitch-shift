<Window x:Class="PitchShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pitch Shift (beta)"
        Icon="AppIcon.ico"
        Width="560" Height="300"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="Root" Margin="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Pitch Shift" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="EngineText" Margin="0,8,0,0" HorizontalAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Window>
