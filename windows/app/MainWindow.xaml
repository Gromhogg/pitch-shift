<Window x:Class="PitchShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PitchShift"
        Title="Pitch Shift (beta)"
        Icon="AppIcon.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PsWindowBack}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- The cards are placed by code (MainWindow.Arrange): side by side, or one above the other in a tall,
         narrow window, and everything grows with the window. -->
    <Canvas x:Name="Root" Background="{DynamicResource PsWindowBack}" ClipToBounds="True">

        <!-- What you hear -->
        <local:ShiftCard x:Name="HearCard" Key="Hear" Title="What you hear">
            <StackPanel>
                <Button x:Name="HearPicker" AutomationProperties.AutomationId="HearPicker"
                        AutomationProperties.Name="Apps" Padding="10,0,8,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="HearPickerChevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource PsIcons}"
                                   FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.8" />
                        <Grid x:Name="HearPickerIconBox" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Image x:Name="HearPickerIcon" Width="16" Height="16" />
                            <TextBlock x:Name="HearPickerGlyph" Text="&#xE767;" FontFamily="{StaticResource PsIcons}"
                                       FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="HearPickerText" Text="All sound" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <!-- Advanced processing (made for music): going up the bass stays deep, going down the top stays bright. -->
                <DockPanel x:Name="AdvancedRow" LastChildFill="True">
                    <local:GradientSwitch x:Name="AdvancedSwitch" DockPanel.Dock="Right" VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="AdvancedSwitch"
                                          AutomationProperties.Name="Advanced processing" />
                    <TextBlock x:Name="AdvancedLabel" Text="Advanced processing" Foreground="{DynamicResource PsTextSecondary}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </local:ShiftCard>

        <!-- Your voice -->
        <local:ShiftCard x:Name="VoiceCard" Key="Voice" Title="Your voice">
            <StackPanel>
                <ComboBox x:Name="MicPicker" AutomationProperties.AutomationId="MicPicker"
                          AutomationProperties.Name="Microphone" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource PsIcons}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <DockPanel x:Name="StyleRow" LastChildFill="True">
                    <Grid x:Name="TestBox" DockPanel.Dock="Right">
                        <Button x:Name="TestButton" Style="{StaticResource PsTestButton}" AutomationProperties.AutomationId="TestButton"
                                AutomationProperties.Name="Test" Content="Test" ToolTip="Record 5 seconds, then play it back" />
                    </Grid>
                    <Border x:Name="StyleBox" Background="{DynamicResource PsSegmentBack}" CornerRadius="6" Padding="2">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="NaturalButton" GroupName="VoiceStyle" Style="{StaticResource PsSegment}"
                                         AutomationProperties.AutomationId="StyleNatural" Content="Natural" />
                            <RadioButton x:Name="CartoonButton" GroupName="VoiceStyle" Style="{StaticResource PsSegment}"
                                         AutomationProperties.AutomationId="StyleCartoon" Content="Cartoon" />
                        </UniformGrid>
                    </Border>
                </DockPanel>

                <Grid x:Name="Footer">
                    <StackPanel x:Name="MicStatus" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                                AutomationProperties.AutomationId="MicStatus"
                                ToolTip="Choose Pitch Shift Mic as the microphone in Discord, Zoom or any app">
                        <local:StatusDot x:Name="MicDot" VerticalAlignment="Center" Margin="2,1,6,0" />
                        <TextBlock x:Name="MicStatusText" Text="Pitch Shift Mic" Foreground="{DynamicResource PsTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ActionButton" AutomationProperties.AutomationId="ActionButton"
                            HorizontalAlignment="Left" Padding="10,0" Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </local:ShiftCard>

        <!-- The alert shown when "Advanced processing" is turned on (it adds delay). It covers the whole window
             until Turn On or Cancel, like a Windows 11 dialog. -->
        <Grid x:Name="AdvancedAlert" Panel.ZIndex="10" Visibility="Collapsed" Background="#4D000000"
              Width="{Binding ActualWidth, ElementName=Root}" Height="{Binding ActualHeight, ElementName=Root}">
            <Grid MaxWidth="380" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                  KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <!-- The shadow on its own layer, so the text stays sharp. -->
                <Border CornerRadius="8" Background="{DynamicResource PsCardBack}">
                    <Border.Effect>
                        <DropShadowEffect Direction="270" ShadowDepth="4" BlurRadius="24" Opacity="0.3" Color="Black" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="8" BorderThickness="1" Background="{DynamicResource PsCardBack}"
                        BorderBrush="{DynamicResource PsCardBorder}">
                    <StackPanel>
                        <StackPanel Margin="20,18,20,16">
                            <TextBlock x:Name="AdvancedAlertTitle" AutomationProperties.AutomationId="AdvancedAlertTitle"
                                       Text="Advanced processing may cause significant audio delay"
                                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource PsText}" />
                            <TextBlock x:Name="AdvancedAlertText" AutomationProperties.AutomationId="AdvancedAlertText"
                                       Text="Sound may lag behind video. It's made for music." Margin="0,8,0,0"
                                       FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource PsText}" />
                            <CheckBox x:Name="AdvancedAlertHide" AutomationProperties.AutomationId="AdvancedAlertHide"
                                      Content="Don't show again" FontSize="14" Margin="0,14,0,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource PsWindowBack}" CornerRadius="0,0,7,7" Padding="20,16">
                            <UniformGrid Columns="2">
                                <Button x:Name="AdvancedAlertTurnOn" AutomationProperties.AutomationId="AdvancedAlertTurnOn"
                                        Style="{StaticResource PsTestButton}" Content="Turn On" FontSize="14" Height="32" Margin="0,0,4,0" />
                                <Button x:Name="AdvancedAlertCancel" AutomationProperties.AutomationId="AdvancedAlertCancel"
                                        Content="Cancel" FontSize="14" Height="32" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Canvas>
</Window>
