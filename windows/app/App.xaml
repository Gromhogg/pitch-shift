<Application x:Class="PitchShift.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <Application.Resources>
        <!-- Light/dark colors are put in by Theme.cs (PsWindowBack, PsCardBack, PsText...). These are fallbacks. -->
        <SolidColorBrush x:Key="PsWindowBack" Color="#F3F3F3" />
        <SolidColorBrush x:Key="PsCardBack" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PsCardBorder" Color="#E5E5E5" />
        <SolidColorBrush x:Key="PsText" Color="#1B1B1B" />
        <SolidColorBrush x:Key="PsTextSecondary" Color="#6E6E6E" />
        <SolidColorBrush x:Key="PsTrackOff" Color="#C8C8C8" />
        <SolidColorBrush x:Key="PsSegmentBack" Color="#EAEAEA" />
        <SolidColorBrush x:Key="PsSegmentHover" Color="#DEDEDE" />
        <SolidColorBrush x:Key="PsDotOff" Color="#B4B4B4" />

        <!-- The icon's colors. -->
        <SolidColorBrush x:Key="PsPurple" Color="#7340F2" />
        <SolidColorBrush x:Key="PsMid" Color="#B346C6" />
        <LinearGradientBrush x:Key="PsGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#7340F2" Offset="0" />
            <GradientStop Color="#F24D99" Offset="1" />
        </LinearGradientBrush>

        <FontFamily x:Key="PsIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- On/off switch: gradient track when on, grey when off, white knob. -->
        <Style x:Key="PsSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource PsTrackOff}" />
                            <Border x:Name="Fill" CornerRadius="11" Background="{StaticResource PsGradient}" Opacity="0" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Slide" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Border x:Name="Focus" CornerRadius="13" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource PsText}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Natural | Cartoon: the chosen half is filled with the middle color. -->
        <Style x:Key="PsSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PsText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource PsSegmentHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource PsMid}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource PsText}" />
                                <Setter TargetName="Back" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Test button: filled purple; plain while recording or playing. -->
        <Style x:Key="PsTestButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PsPurple}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Back" CornerRadius="5" Background="{TemplateBinding Background}" />
                            <Border x:Name="Shine" CornerRadius="5" Background="White" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="6" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource PsText}" Visibility="Collapsed" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big number: just the text, no button look. -->
        <Style x:Key="PsBareButton" TargetType="Button">
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The typing box for the big number: no border or underline. -->
        <Style x:Key="PsBareTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
